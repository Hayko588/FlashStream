{
  "Redis": {
    "ConnectionString": "localhost:6379",
    "ProductCacheDurationSeconds": 30
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "OrderRequestsTopic": "order-events",
    "OrderUpdatesTopic": "order-updates",
    "ConsumerGroup": "flashstream-order-workers",
    "TopicPartitions": 3,
    "ReplicationFactor": 1
  },
  "RateLimit": {
    "RequestsPerWindow": 60,
    "WindowSeconds": 60
  },
  "OrderPolicy": {
    "MaximumQuantity": 100
  },
  "Infrastructure": {
    "OutboxRetryDelaySeconds": 5,
    "OutboxLeaseSeconds": 30,
    "OutboxPollIntervalMilliseconds": 500
  },
  "Security": {
    "MaxRequestBodyBytes": 16384
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;api"
}
