{
  "Kafka": {
    "InventoryReservationRequestsTopic": "inventory-reservation-requests",
    "InventoryReservationResultsTopic": "inventory-reservation-results",
    "InventoryConsumerGroup": "flashstream-inventory"
  },
  "Outbox": {
    "RetryDelaySeconds": 5,
    "LeaseSeconds": 30,
    "PollIntervalMilliseconds": 500
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}
