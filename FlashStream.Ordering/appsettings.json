{
  "Order": {
    "MaximumQuantity": 100
  },
  "Kafka": {
    "InventoryReservationRequestsTopic": "inventory-reservation-requests",
    "InventoryReservationResultsTopic": "inventory-reservation-results",
    "OrderingConsumerGroup": "flashstream-ordering"
  },
  "Outbox": {
    "RetryDelaySeconds": 5,
    "LeaseSeconds": 30,
    "PollIntervalMilliseconds": 500
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
